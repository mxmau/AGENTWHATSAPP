# Chave gratuita do Google Gemini — obtenha em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Grupos da escola (nomes exatos como aparecem no WhatsApp)
GROUP_ESCOLA_1=Ecilda Ramos 2026
GROUP_ESCOLA_2=Professores - Tiradentes

# Grupo da igreja
GROUP_IGREJA=Ministro e Obreiros IIGD BV

# Contatos pessoais
CONTACT_ESPOSA=Rafaelly
CONTACT_PASTOR=PR Josehilton
# CONTACT_EU: deixe vazio para usar o chat "Recados" (mensagens para si mesmo)
CONTACT_EU=

PORT=3001
# Quantas horas atrás buscar mensagens em cada execução (padrão: 12)
HOURS_LOOKBACK=12
# Quantas mensagens mostrar no log para auditoria de leitura
LOG_MESSAGE_PREVIEW_LIMIT=10
# Quantas mensagens mostrar por candidato de chat encontrado
LOG_CANDIDATE_MESSAGE_LIMIT=20

# Persistência gratuita opcional: use a connection string do Supabase/Postgres.
# Sem isso, a sessão do WhatsApp fica só no disco local e pode sumir em hospedagem gratuita.
DATABASE_URL=
DATABASE_SSL=true

# Telegram Bot Token + Chat ID para notificações (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
